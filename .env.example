# Copy to .env.local (never commit .env.local). Every variable is documented here.

# --- Demo / UX ----------------------------------------------------------------
# 1 = show the "Demo: test sats, sample data" banner everywhere.
DEMO_MODE=1
# Fallback BTC prices when the rates API is unreachable (whole fiat units per 1 BTC).
FALLBACK_BTC_NGN=87000000
FALLBACK_BTC_XOF=38500000

# --- AI (server only) ---------------------------------------------------------
# Google AI Studio key. Free tier: use demo/seed data only, never real users' data.
GEMINI_API_KEY=
# Confirm the current Flash-Lite model ID in AI Studio before the demo.
GEMINI_MODEL=gemini-2.5-flash-lite
# 1 = return fixtures from packages/ai/fixtures instead of calling Gemini (tests, offline demo).
AI_MOCK=0

# --- Lightning / Nostr (server only) ------------------------------------------
# Sponsor/funder wallet (Kàddu, NdoxWatch). In production: pay_invoice-only, with a budget + expiry.
SPONSOR_NWC_URL=
# Server key for attestations (nsec1... or 64-hex). Generate one; never reuse a personal key.
SERVER_NOSTR_NSEC=
# Comma-separated wss:// relays to publish attestations/receipts to (best-effort).
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol
# Comma-separated wss:// origins the BROWSER may open for NWC (CSP connect-src).
# `pnpm nwc:probe` prints each wallet's relay origin; copy them here.
NWC_RELAY_ORIGINS=

# --- Admin / payouts (server only) ---------------------------------------------
# Long random string. Compared in constant time.
ADMIN_TOKEN=
# Postgres connection string (Kàddu, NdoxWatch only). Local docker: see docker-compose.yml.
DATABASE_URL=postgres://sats:sats@localhost:5432/sats
# App-level spending caps on top of the NWC budget (faucet wallets may not enforce budgets).
MAX_DAILY_PAYOUT_SATS=5000
MAX_CLAIM_SATS=1000
