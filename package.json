{
  "name": "sats-starter",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "wallets:new": "tsx scripts/wallets-new.ts",
    "nwc:probe": "tsx scripts/nwc-probe.ts",
    "nwc:latency": "tsx scripts/nwc-latency.ts",
    "seed": "tsx scripts/seed.ts",
    "demo": "pnpm install && tsx scripts/demo.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@sats/core": "workspace:*",
    "@sats/lightning": "workspace:*"
  }
}
